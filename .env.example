# 复制为 .env 后填写真实值。.env 已被 .gitignore 忽略，请勿提交凭据。

# Flask
FLASK_SECRET_KEY=

# AList：本地媒体来源
ALIST_ORIGIN=http://127.0.0.1:5244
ALIST_USERNAME=
ALIST_PASSWORD=
ALIST_DIR=
ALIST_AUTOSTART=1
# AList 路径保护密码（如启用）
# ALIST_PATH_PASSWORD=
# 媒体导入根目录，留空表示不限制
# ALIST_IMPORT_ROOT=

# TMDB：简介、演员与图片补充
TMDB_TOKEN=
# 可选：反向代理或镜像地址
# TMDB_API_ORIGIN=https://api.themoviedb.org/3
# TMDB_IMAGE_ORIGIN=https://image.tmdb.org/t/p

# MDBList：评分补充
# MDBLIST_APIKEY=

# ffprobe 与播放器
FFPROBE_PATH=ffprobe
FFPROBE_TIMEOUT=60
# MPC_WEB_URL=http://127.0.0.1:13579

# 性能剖析，设为 1 开启
# FLASK_PROFILING=

# Cloudflare 只读快照：设置令牌后，应用启动及 library.db 变化时自动同步到云端
# MOVIEDB_SYNC_TOKEN=
# MOVIEDB_SYNC_URL=https://moviedb-router.ccpcudati.workers.dev
# 设为 1 临时关闭自动同步
# MOVIEDB_SYNC_DISABLED=
