# 复制为 .env 后填写真实值。.env 已被 .gitignore 忽略，请勿提交凭据。
# 源码运行时 .env 与数据放在项目目录；安装版放在用户数据目录
# （Windows %LOCALAPPDATA%\MovieDB，macOS ~/Library/Application Support/MovieDB）。
# 用环境变量 MOVIEDB_DATA_DIR 可以指定其他数据目录。

# Flask
FLASK_SECRET_KEY=

# 内置网盘接口的每秒请求数与同时在途请求数
# DRIVE_RATE=20
# DRIVE_CONCURRENCY=4
# 媒体导入根目录，留空表示不限制
# MEDIA_IMPORT_ROOT=

# TMDB：简介、演员与图片补充
# 可选：自己的密钥（API 读访问令牌或 32 位 API Key）；安装版留空使用内置密钥，源码运行需要填写
# TMDB_TOKEN=
# 可选：反向代理或镜像地址；留空时 api.themoviedb.org 连不上会自动改用 api.tmdb.org
# TMDB_API_ORIGIN=https://api.themoviedb.org/3
# 海报加载不出来时可用公共图片加速：https://wsrv.nl/?url=https://image.tmdb.org/t/p
# TMDB_IMAGE_ORIGIN=https://image.tmdb.org/t/p
# 可选：访问 TMDB 用的 HTTP 代理（只对 TMDB 生效），如 http://127.0.0.1:7890
# TMDB_PROXY=
# 扫描、识别、导入共用的请求速率预算（默认 25，最高 30，无突发积攒）
# TMDB_RATE=25

# AI 识别（可选）：OpenAI 兼容接口，用于规则识别不确定的待关联目录
# 推荐 DeepSeek：LLM_BASE_URL=https://api.deepseek.com，LLM_MODEL=deepseek-flash
# （自动走 Responses API、关闭思考模式、只限并发不限每分钟次数）
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=
# 接口类型：responses（/responses）或 chat（/chat/completions）；默认 DeepSeek 用 responses，其它平台用 chat
# LLM_API=
# 思考模式：none（默认，关闭）/ low / high / max；仅 DeepSeek 生效，识别片名不需要思考
# LLM_THINKING=none
# 合并请求：每次请求最多带几条待识别目录，DeepSeek 默认 8，其它平台默认 20（1–50）
# LLM_BATCH_SIZE=
# 同时在途的 AI 请求数（1–500）：DeepSeek 默认 64（官方按账号并发限流，flash 上限 2500），其它平台默认 2；遇到 429 自动减半再逐步恢复
# LLM_CONCURRENCY=
# 非 DeepSeek 平台的免费额度一般按分钟限次：AI 请求每分钟上限，默认 10（DeepSeek 忽略此项）
# LLM_RPM=10

# 待关联扫描：启动时在后台扫描所选目录，设为 0 关闭
# MOVIEDB_AUTOSCAN=1
# 同时准备核心关联的作品数（1–16）；资料补齐使用独立资源池和有界活跃窗口
# IMPORT_TITLE_CONCURRENCY=4
# 扫描、识别、关联任务、网盘配置、请求预算与评分缓存的存储位置，默认与 library.db 同目录的 local.db
# MOVIEDB_LOCAL_DATABASE=

# MDBList：评分补充
# MDBLIST_APIKEY=
# 连续 24 小时的请求预算，默认 900；按账号套餐留出余量，重试也计数
# MDBLIST_DAILY_BUDGET=900
# 每秒请求预算，最高 2
# MDBLIST_RATE=2

# 豆瓣评分：默认开启（非官方接口，可能随时失效），设为 0 关闭
# DOUBAN_ENABLED=1

# ffprobe 与播放器
FFPROBE_PATH=ffprobe
FFPROBE_TIMEOUT=60
# 所有导入任务合计的 ffprobe 进程数，默认 3（1–8）
# FFPROBE_CONCURRENCY=3
# 每个挂载第一级目录的探测并发，默认跟随全局上限；风控严格时调低
# FFPROBE_PER_SOURCE=3
# 缩略图与色调处理的共享并发数（1–8）
# IMAGE_CONCURRENCY=2
# 播放器：留空自动选择（Windows MPC-HC → mpv → VLC，macOS IINA → mpv → VLC），
# 也可以填 mpc-hc / iina / mpv / vlc / system
# PLAYER=
# 非 MPC-HC 播放器的程序路径，macOS 可以填 .app
# PLAYER_PATH=/Applications/IINA.app
# MPC_PATH=C:\Program Files\MPC-HC\mpc-hc64.exe
# MPC_WEB_URL=http://127.0.0.1:13579

# 桌面版本机端口，默认 5000；修改后需重启
# MOVIEDB_PORT=5000

# 桌面版界面打开方式：留空为独立窗口，browser 为系统浏览器；修改后需重启
# MOVIEDB_UI=

# 性能剖析，设为 1 开启
# FLASK_PROFILING=

# Cloudflare 只读快照：设置令牌后，应用启动及 library.db 变化时自动同步到云端
# MOVIEDB_SYNC_TOKEN=
# MOVIEDB_SYNC_URL=https://moviedb-router.ccpcudati.workers.dev
# 设为 1 临时关闭自动同步
# MOVIEDB_SYNC_DISABLED=
