# 复制为 .env 后填写真实值。.env 已被 .gitignore 忽略，请勿提交凭据。

# Flask
FLASK_SECRET_KEY=

# AList：本地媒体来源
ALIST_ORIGIN=http://127.0.0.1:5244
ALIST_USERNAME=
ALIST_PASSWORD=
ALIST_DIR=
ALIST_AUTOSTART=1
# AList 路径保护密码（如启用）
# ALIST_PATH_PASSWORD=
# 访问 AList（及其后的网盘）的每秒请求数与同时在途请求数，网盘风控严格时调低
# ALIST_RATE=20
# ALIST_CONCURRENCY=4
# 媒体导入根目录，留空表示不限制
# ALIST_IMPORT_ROOT=

# TMDB：简介、演员与图片补充
TMDB_TOKEN=
# 可选：反向代理或镜像地址
# TMDB_API_ORIGIN=https://api.themoviedb.org/3
# TMDB_IMAGE_ORIGIN=https://image.tmdb.org/t/p
# 可选：访问 TMDB 用的 HTTP 代理（只对 TMDB 生效），如 http://127.0.0.1:7890
# TMDB_PROXY=

# AI 识别（可选）：OpenAI 兼容接口，用于规则识别不确定的待关联目录
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=
# 接口类型：chat（/chat/completions，默认）或 responses（/responses）
# LLM_API=chat
# 免费额度一般按分钟限次：AI 请求每分钟上限，默认 10
# LLM_RPM=10

# 待关联扫描：启动时在后台扫描所选目录，设为 0 关闭
# MOVIEDB_AUTOSCAN=1
# 识别结果、扫描目录、忽略列表与源文件状态的存储位置，默认与 library.db 同目录的 discovery.db
# MOVIEDB_DISCOVERY_DATABASE=

# MDBList：评分补充
# MDBLIST_APIKEY=

# ffprobe 与播放器
FFPROBE_PATH=ffprobe
FFPROBE_TIMEOUT=60
# 导入时并行读取媒体信息的 ffprobe 进程数，默认 3
# FFPROBE_CONCURRENCY=3
# MPC_WEB_URL=http://127.0.0.1:13579

# 性能剖析，设为 1 开启
# FLASK_PROFILING=

# Cloudflare 只读快照：设置令牌后，应用启动及 library.db 变化时自动同步到云端
# MOVIEDB_SYNC_TOKEN=
# MOVIEDB_SYNC_URL=https://moviedb-router.ccpcudati.workers.dev
# 设为 1 临时关闭自动同步
# MOVIEDB_SYNC_DISABLED=
